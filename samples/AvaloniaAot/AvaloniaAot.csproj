<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <ProjectReference Include="..\..\src\Simple.Avalonia.Hosting\Simple.Avalonia.Hosting.csproj" />
    <ProjectReference Include="..\AvaloniaView\AvaloniaView.csproj" />
    <ProjectReference Include="..\WpfViewModels\WpfViewModels.csproj" />
    <TrimmerRootAssembly Include="Simple.Avalonia.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\AvaloniaHosting\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
